<?xml version="1.0" encoding="utf-8"?>
<!-- Warm coral -> amber gradient behind the white alarm clock. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="6"
                android:startY="0"
                android:endX="102"
                android:endY="108"
                android:startColor="#FFFFC978"
                android:centerColor="#FFF98A5E"
                android:endColor="#FFDD3F3A" />
        </aapt:attr>
    </path>

    <!-- soft highlight in the top-left corner, keeps the flat gradient from looking dead -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="26"
                android:centerY="18"
                android:gradientRadius="70"
                android:startColor="#40FFFFFF"
                android:endColor="#00FFFFFF" />
        </aapt:attr>
    </path>
</vector>
